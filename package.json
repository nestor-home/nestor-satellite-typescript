{
  "name": "@nestor-home/satellite",
  "version": "0.6.0",
  "description": "TypeScript SDK to write Nestor satellites, in browsers and in Node: pairing, the WebSocket link, text, and WebRTC audio as an option.",
  "keywords": [
    "nestor",
    "satellite",
    "voice assistant",
    "websocket",
    "webrtc",
    "home automation"
  ],
  "homepage": "https://nestorhome.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nestor-home/nestor-satellite-typescript.git"
  },
  "bugs": "https://github.com/nestor-home/nestor-satellite-typescript/issues",
  "license": "MIT",
  "author": "Mathis Lambert",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.18.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./qr": {
      "types": "./dist/qr/index.d.ts",
      "default": "./dist/qr/index.js"
    },
    "./voice": {
      "types": "./dist/voice/index.d.ts",
      "default": "./dist/voice/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./voice/*": "./voice/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "nestor-satellite": "dist/node/bin.js"
  },
  "files": [
    "dist",
    "src",
    "schemas",
    "voice"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/node/bin.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "conformance": "pnpm build && vitest run --config vitest.conformance.config.ts",
    "package:check": "pnpm build && publint --strict && attw --pack . --profile esm-only",
    "example": "vite --config examples/browser/vite.config.ts"
  },
  "peerDependencies": {
    "@roamhq/wrtc": "^0.10.0",
    "zxing-wasm": "^3.1.6"
  },
  "peerDependenciesMeta": {
    "@roamhq/wrtc": {
      "optional": true
    },
    "zxing-wasm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.7",
    "@roamhq/wrtc": "0.10.0",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "playwright-core": "1.65.0",
    "publint": "0.3.25",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "ws": "8.23.0",
    "zxing-wasm": "3.1.6"
  },
  "dependencies": {
    "@fluent/bundle": "0.19.1"
  }
}
